{
  "retention_days": 180,
  "max_items": 400,
  "fetch_meta_description": true,
  "keywords": [
    "gastric",
    "stomach cancer",
    "gastroesophageal",
    "gastro-esophageal",
    "gastresophageal",
    "esophagogastric",
    "oesophagogastric",
    "GEJ",
    "G/GEJ",
