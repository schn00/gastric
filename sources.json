    {
      "name": "Google News",
      "url": "https://news.google.com/rss/search?q=%22gastric+cancer%22+OR+%22gastroesophageal%22+OR+%22stomach+cancer%22&hl=en-US&gl=US&ceid=US:en",
      "enabled": true,
      "derive_source": true,
