  "feeds": [
    {
      "name": "FDA",
      "url": "https://www.fda.gov/about-fda/contact-fda/stay-informed/rss-feeds/press-releases/rss.xml",
      "enabled": true
    },
    {
      "name": "FDA drug safety",
      "url": "https://www.fda.gov/about-fda/contact-fda/stay-informed/rss-feeds/medwatch/rss.xml",
      "enabled": false
    },
    {
      "name": "NCI",
      "url": "https://www.cancer.gov/publishedcontent/rss/syndication/rss/ncinewsreleases.rss",
      "enabled": true
    },
    {
      "name": "NCI Cancer Currents",
      "url": "https://www.cancer.gov/publishedcontent/rss/news-events/cancer-currents-blog.rss",
      "enabled": true
    },
    {
      "name": "OncLive",
      "url": "https://www.onclive.com/rss/news",
      "enabled": false,
      "browser_agent": true,
      "note": "403 from GitHub Actions under both user-agents - the CDN blocks datacenter IPs. Covered indirectly via Google News."
    },
    {
      "name": "Medscape Oncology",
      "url": "https://www.medscape.com/cx/rssfeeds/2700.xml",
      "enabled": true,
      "note": "General Medscape news, not the oncology feed. Works, but gastric hits are occasional."
    },
    {
      "name": "ASCO Post",
      "url": "https://ascopost.com/rss/",
      "enabled": false,
      "note": "This URL returns ~39k entries, so it is not the news feed. Find the real one on ascopost.com and re-enable."
    },
    {
      "name": "Targeted Oncology",
      "url": "https://www.targetedonc.com/rss/news",
      "enabled": false,
      "browser_agent": true,
      "note": "Same 403 as OncLive. Covered indirectly via Google News."
    },
    {
      "name": "Healio Gastrointestinal",
      "url": "https://www.healio.com/rss/hematology-oncology",
      "enabled": true
    },
    {
      "name": "Google News",
      "url": "https://news.google.com/rss/search?q=%28%22gastric+cancer%22+OR+%22gastroesophageal%22+OR+%22stomach+cancer%22%29+AND+%28metastatic+OR+advanced+OR+unresectable+OR+%22stage+IV%22%29&hl=en-US&gl=US&ceid=US:en",
      "enabled": true,
      "derive_source": true,
      "note": "Aggregator, query narrowed to advanced/metastatic disease. derive_source pulls the real outlet out of the headline. Links redirect via Google."
    }
  ],
